---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/** A photograph that fills its positioned parent. */
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  style?: string;
}

const { src, alt, sizes = '(min-width: 900px) 50vw, 100vw', loading = 'lazy', class: className, style } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={[...new Set([480, 800, 1200, 1600].filter((w) => w < src.width).concat(Math.min(src.width, 1920)))]}
  sizes={sizes}
  quality={72}
  loading={loading}
  style={style}
  class:list={['absolute inset-0 size-full object-cover', className]}
/>
