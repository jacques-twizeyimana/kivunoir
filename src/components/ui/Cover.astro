---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/** A photograph that fills its positioned parent. */
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { src, alt, sizes = '(min-width: 900px) 50vw, 100vw', loading = 'lazy', class: className } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={[480, 800, 1200, src.width]}
  sizes={sizes}
  loading={loading}
  class:list={['absolute inset-0 size-full object-cover', className]}
/>
