---
export interface Step {
  where: string;
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="grid grid-cols-1 gap-x-6 gap-y-16 sm:grid-cols-2 md:grid-cols-4">
  {
    steps.map((step) => (
      <li class="flex flex-col gap-3 border-t-2 border-line-strong pt-6">
        <span class="text-eyebrow text-roast uppercase">{step.where}</span>
        <h3 class="text-title" set:html={step.title} />
        <p class="text-row text-ink-muted">{step.text}</p>
      </li>
    ))
  }
</ol>
