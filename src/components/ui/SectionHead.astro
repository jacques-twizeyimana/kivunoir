---
import Display from './Display.astro';
import Eyebrow from './Eyebrow.astro';
import TextLink from './TextLink.astro';

interface Props {
  eyebrow: string;
  title: string;
  roast?: boolean;
  size?: 'lg' | 'heading';
  /** A text link on the right; pass a slot="action" element instead for a button. */
  link?: { href: string; label: string };
  class?: string;
}

const { eyebrow, title, roast = false, size = 'lg', link, class: className } = Astro.props;
---

<div class:list={['mb-12 flex flex-wrap items-end justify-between gap-8', className]}>
  <div class="flex max-w-measure flex-col gap-4">
    <Eyebrow roast={roast}>{eyebrow}</Eyebrow>
    <Display size={size}>{title}</Display>
    <slot />
  </div>
  <slot name="action">{link && <TextLink href={link.href}>{link.label}</TextLink>}</slot>
</div>
