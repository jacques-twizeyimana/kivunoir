---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  roast?: boolean;
  class?: string;
}

const { as: Tag = 'p', roast = false, class: className } = Astro.props;
---

<Tag class:list={['text-eyebrow uppercase', roast ? 'text-roast' : 'text-ink-muted', className]}>
  <slot />
</Tag>
