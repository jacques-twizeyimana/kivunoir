---
/** Full-bleed photograph beside a block of copy. */
interface Props {
  theme?: 'blanc' | 'noir';
  flip?: boolean;
  id?: string;
}

const { theme = 'noir', flip = false, id } = Astro.props;
---

<section id={id} data-theme={theme} class="grid md:grid-cols-2">
  <div class:list={['relative min-h-105 overflow-hidden bg-noir-900 md:min-h-160', flip && 'md:order-2']}>
    <slot name="media" />
  </div>
  <div class="flex flex-col justify-center gap-8 px-4 py-16 sm:px-6 md:p-24">
    <slot />
  </div>
</section>
